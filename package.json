{
  "name": "cnc-cabinet-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "npm run build -w @cabgen/core && npm run build -w @cabgen/web",
    "dev": "npm run dev -w @cabgen/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/core apps/web"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
